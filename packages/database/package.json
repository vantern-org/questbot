{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@questbot/database",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "prisma generate && tsc",
