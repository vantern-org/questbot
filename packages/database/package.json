	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"prisma": "^7.10.0"
	},
	"devDependencies": {
		"dotenv-cli": "^11.0.0",
		"typescript": "~7.0.2"
	}
}
