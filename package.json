{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "questbot-workspace",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.24.0",
			"onFail": "ignore"
		}
	},
	"scripts": {
		"build": "dotenv -e .env -- turbo run build",
		"dev": "dotenv -e .env -- turbo run dev",
		"lint": "biome check .",
		"format": "biome check --write .",
		"start": "pnpm --filter @questbot/bot start",
		"db:push": "dotenv -e .env -- turbo run db:push",
		"db:generate": "dotenv -e .env -- turbo run db:generate",
		"prisma": "pnpm --filter @questbot/bot prisma",
		"clean": "dotenv -e .env -- turbo run build --force && rm -rf node_modules apps/*/node_modules dist .turbo"
	},
	"dependencies": {
		"discord.js": "^14.27.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"dotenv-cli": "^11.0.0",
		"turbo": "^2.10.12"
	}
}
