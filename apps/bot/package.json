{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@questbot/bot",
	"version": "0.1.5",
	"private": true,
	"type": "module",
	"description": "A Discord bot built with Sapphire framework",
	"license": "AGPL-3.0-or-later",
	"author": "Vantern",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vantern-org/questbot.git"
	},
	"main": "./dist/index.js",
	"bin": {
		"questbot": "./dist/sharder.js"
	},
	"files": ["dist", "prisma/schema.prisma", "README.md", "LICENSE"],
	"scripts": {
		"build": "rimraf dist && tsc",
		"start": "node --env-file-if-exists=../../.env --import ./dist/telemetry.js dist/sharder.js",
		"dev": "concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"tsx watch --conditions development --env-file-if-exists=../../.env src/index.ts\"",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@discordjs/core": "^2.6.0",
		"@opentelemetry/api-logs": "^0.222.0",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@questbot/database": "workspace:*",
		"@sapphire/framework": "^5.5.1",
		"@types/ms": "^2.1.0",
		"bullmq": "^5.81.4",
		"countries-and-timezones": "^3.10.0",
		"discord.js": "^14.27.0",
		"ioredis": "^5.11.1",
		"ipaddr.js": "^2.5.0",
		"ms": "^2.1.3",
		"sharp": "^0.35.4",
		"syllable-count-english": "^1.0.6",
		"undici": "^8.10.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^26.1.2",
		"concurrently": "^10.0.5",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.13",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"imports": {
		"#utils/*": {
			"development": "./src/util/*",
			"default": "./dist/util/*"
		},
		"#lib/*": {
			"development": "./src/lib/*",
			"default": "./dist/lib/*"
		}
	}
}
